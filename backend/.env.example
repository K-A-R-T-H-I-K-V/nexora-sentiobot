# SentioBot backend configuration.
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed.
# Only the variables the app actually reads are listed here.

# --- LLM ---
# Provider: "groq" (default, ratified) or "gemini".
LLM_PROVIDER=groq
# Groq (free tier): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (only needed if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# --- Supabase (app data: users, orders, conversations, analytics) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Increment 10 (RLS-with-JWT): set BOTH of these to turn on database-enforced,
# fail-closed authorization (else the app uses the service-role + app-layer
# checks from Increments 1-9). From Supabase dashboard -> Settings -> API:
#   SUPABASE_ANON_KEY  = the "anon / public" key
#   SUPABASE_JWT_SECRET = the "JWT Secret"
# Then run supabase/migrations/increment10_rls.sql once.
# TRANSITION RISK (I10-1): SUPABASE_JWT_SECRET is the project's LEGACY SHARED HS256
# secret. The app signs its own auth tokens with it so Postgres RLS accepts them. Do
# NOT revoke this legacy key, and do NOT switch the project to asymmetric signing
# (ES256/RS256 via JWKS) or rotate the secret without updating the app FIRST: because
# _user_db() fails CLOSED, a token the DB can no longer verify denies ALL user-owned
# data access until the app is updated. Long-term fix: adopt Supabase Auth / JWKS
# (a logged future increment).
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Auth ---
# REQUIRED. The app refuses to start (unless DEBUG=true) while this is empty
# or the placeholder. Generate a strong secret with:  openssl rand -hex 32
JWT_SECRET=

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Cache: optional L3 Redis. Leave empty for in-process L1/L2 only. ---
REDIS_URL=

# --- Runtime ---
DEBUG=false

# --- Optional overrides (sensible defaults exist in backend/core/config.py) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=2048
# AGENT_MAX_TOOL_ROUNDS=4
# USE_MULTIQUERY=false   # Increment 4: base ensemble by default; set true to A/B the multi-query retriever
# SEMANTIC_CACHE_THRESHOLD=0.92

# --- Increment 5: resilience + request guards ---
# LLM_TIMEOUT_SECONDS=30       # per provider call; SDK backs off between retries
# LLM_MAX_RETRIES=2            # transient 429/5xx are retried with backoff
# RETRIEVAL_TIMEOUT_SECONDS=20 # bound retrieval so a hung call cannot stall a request
# MAX_INPUT_CHARS=8000         # reject longer messages before any retrieval/LLM work
# RATE_LIMIT_PER_MINUTE=20     # per-user cap on /chat/stream (0 disables; in-process/per-worker)
