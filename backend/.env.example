# SentioBot backend configuration.
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed.
# Only the variables the app actually reads are listed here.

# --- LLM ---
# Provider: "groq" (default, ratified) or "gemini".
LLM_PROVIDER=groq
# Groq (free tier): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (only needed if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# --- Supabase (app data: users, orders, conversations, analytics) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# --- Auth ---
# REQUIRED. The app refuses to start (unless DEBUG=true) while this is empty
# or the placeholder. Generate a strong secret with:  openssl rand -hex 32
JWT_SECRET=

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Cache: optional L3 Redis. Leave empty for in-process L1/L2 only. ---
REDIS_URL=

# --- Runtime ---
DEBUG=false

# --- Optional overrides (sensible defaults exist in backend/core/config.py) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=2048
# AGENT_MAX_ITERATIONS=8
# SEMANTIC_CACHE_THRESHOLD=0.92
